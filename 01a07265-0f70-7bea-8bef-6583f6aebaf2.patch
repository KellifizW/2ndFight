+// ── Lifecycle-state filter (CSS-driven, works together with strategy tabs) ───
+function setWlState(state, el) {
+  document.getElementById('wlBody').dataset.stateFilter = state;
+  document.querySelectorAll('#stateFilter button').forEach(b => {
+    const st = b.dataset.state;
+    const cls = {ALL:'accent', BUILDING:'secondary', READY:'warning', TRIGGERED:'success',
+                 EXTENDED:'info', INVALIDATED:'danger', COLD_WATCH:'dark'}[st] || 'secondary';
+    b.className = `btn btn-sm btn-${b === el ? '' : 'outline-'}${cls}`;
+  });
+  applyWlFilters();
+}
+
+function applyWlFilters() {
+  const body = document.getElementById('wlBody');
+  if (!body) return;
+  const strat = body.dataset.strategyFilter || 'all';
+  const state = body.dataset.stateFilter || 'ALL';
+  body.querySelectorAll('tr[data-strategy]').forEach(tr => {
+    const okS = (strat === 'all' || tr.dataset.strategy === strat);
+    const okState = (state === 'ALL' || tr.dataset.state === state);
+    tr.style.display = (okS && okState) ? '' : 'none';
+  });
+}
