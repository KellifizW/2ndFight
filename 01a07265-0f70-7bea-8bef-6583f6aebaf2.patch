+"""Service-layer tests for the watchlist follow-up tracking (modules/watchlist.py).
+
+These exercise track() / tracked_rows() / review() / timeline() / prune() against a
+temporary JSON store with synthetic price data, so no network access is needed.
+"""
+
+from __future__ import annotations
+
+import json
+
+import numpy as np
+import pandas as pd
+import pytest
+
+
+@pytest.fixture()
+def wl_mod(tmp_path, monkeypatch):
+    """Import modules.watchlist with an isolated JSON store and stubbed data feeds."""
+    from modules import watchlist as m
+
+    store = tmp_path / "watchlist.json"
+    monkeypatch.setattr(m, "WATCHLIST_FILE", store)
+    monkeypatch.setattr(m.C, "DB_ENABLED", False, raising=False)
+    # never hit the earnings API in tests
+    monkeypatch.setattr(m, "_days_to_catalyst", lambda t: None)
+    return m
+
+
+def _make_df(closes, volumes=None, start="2025-01-01"):
+    n = len(closes)
+    idx = pd.bdate_range(start, periods=n)
+    close = np.asarray(closes, dtype=float)
+    vol = np.asarray(volumes if volumes is not None else [1_000_000.0] * n, dtype=float)
+    return pd.DataFrame(
+        {"Open": close - 0.1, "High": close + 0.5, "Low": close - 0.5,
+         "Close": close, "Volume": vol},
+        index=idx,
+    )
+
+
+def _seed(wl_mod, entries: dict):
+    """Write a watchlist JSON directly (bypassing add()'s network calls)."""
+    data = {"SEPA": {}, "QM": {}, "ML": {}}
+    for ticker, (strategy, entry) in entries.items():
+        data[strategy][ticker] = entry
+    wl_mod.WATCHLIST_FILE.parent.mkdir(parents=True, exist_ok=True)
+    wl_mod.WATCHLIST_FILE.write_text(json.dumps(data), encoding="utf-8")
+
+
+def _flat_then_breakout():
+    base = list(100 + np.sin(np.linspace(0, 8, 159)))
+    return _make_df(base + [112.0], volumes=[1_000_000.0] * 159 + [6_000_000.0])
+
+
+def test_track_populates_baseline_and_state(wl_mod, monkeypatch):
+    _seed(wl_mod, {"GOOG": ("SEPA", {"added_date": "2025-01-01", "market": "US",
+                                     "strategy": "SEPA", "pivot": 104.0})})
+    df = _flat_then_breakout()
+    monkeypatch.setattr(wl_mod, "get_enriched", lambda t, period="2y": df)
+    monkeypatch.setattr(wl_mod, "detect_vcp", lambda d: {"grade": "B"})
+
+    wl = wl_mod.track(market="US")
+    e = wl["SEPA"]["GOOG"]
+    assert e["baseline"]["ref_close"] == 112.0
+    assert e["tracking"]["state"] == "TRIGGERED"
+    assert e["tracking"]["proximity_score"] > 0
+    # persisted to disk
+    saved = json.loads(wl_mod.WATCHLIST_FILE.read_text(encoding="utf-8"))
+    assert saved["SEPA"]["GOOG"]["tracking"]["state"] == "TRIGGERED"
+
+
+def test_track_single_ticker_only(wl_mod, monkeypatch):
+    _seed(wl_mod, {
+        "AAA": ("SEPA", {"added_date": "2025-01-01", "market": "US"}),
+        "BBB": ("QM", {"added_date": "2025-01-01", "market": "US"}),
+    })
+    df = _flat_then_breakout()
+    monkeypatch.setattr(wl_mod, "get_enriched", lambda t, period="2y": df)
+    monkeypatch.setattr(wl_mod, "detect_vcp", lambda d: {})
+
+    wl = wl_mod.track(ticker="AAA", market="US")
+    assert wl["SEPA"]["AAA"].get("tracking")
+    assert not wl["QM"]["BBB"].get("tracking")
+
+
+def test_track_skips_other_markets(wl_mod, monkeypatch):
+    _seed(wl_mod, {
+        "AAA": ("SEPA", {"added_date": "2025-01-01", "market": "US"}),
+        "0700": ("SEPA", {"added_date": "2025-01-01", "market": "HK"}),
+    })
+    monkeypatch.setattr(wl_mod, "get_enriched", lambda t, period="2y": _flat_then_breakout())
+    monkeypatch.setattr(wl_mod, "detect_vcp", lambda d: {})
+
+    wl = wl_mod.track(market="HK")
+    assert wl["SEPA"]["0700"].get("tracking")
+    assert not wl["SEPA"]["AAA"].get("tracking")
+
+
+def test_track_survives_data_errors(wl_mod, monkeypatch):
+    _seed(wl_mod, {"BAD": ("SEPA", {"added_date": "2025-01-01", "market": "US"})})
+
+    def boom(t, period="2y"):
+        raise RuntimeError("feed down")
+
+    monkeypatch.setattr(wl_mod, "get_enriched", boom)
+    wl = wl_mod.track(market="US")           # must not raise
+    assert "BAD" in wl["SEPA"]
+
+
+def test_tracked_rows_sorted_and_timeline(wl_mod, monkeypatch):
+    _seed(wl_mod, {
+        "AAA": ("SEPA", {"added_date": "2025-01-01", "market": "US", "pivot": 104.0}),
+        "BBB": ("QM", {"added_date": "2025-01-01", "market": "US", "pivot": 999.0}),
+    })
+    df = _flat_then_breakout()
+    monkeypatch.setattr(wl_mod, "get_enriched", lambda t, period="2y": df)
+    monkeypatch.setattr(wl_mod, "detect_vcp", lambda d: {})
+    wl_mod.track(market="US")
+
+    rows = wl_mod.tracked_rows("US")
+    assert len(rows) == 2
+    scores = [r["proximity_score"] for r in rows]
+    assert scores == sorted(scores, reverse=True)     # ranked desc
+    assert rows[0]["ticker"] == "AAA"                 # broke out -> ranks first
+
+    tl = wl_mod.timeline("AAA", "US")
+    assert tl["ticker"] == "AAA"
+    assert tl["baseline"]["ref_close"] == 112.0
+    assert len(tl["events"]) > 0
+    assert wl_mod.timeline("ZZZ", "US") == {}
+
+
+def test_review_and_alerts(wl_mod, monkeypatch):
+    _seed(wl_mod, {"AAA": ("SEPA", {"added_date": "2025-01-01", "market": "US",
+                                    "pivot": 104.0})})
+    monkeypatch.setattr(wl_mod, "get_enriched", lambda t, period="2y": _flat_then_breakout())
+    monkeypatch.setattr(wl_mod, "detect_vcp", lambda d: {})
+    wl_mod.track(market="US")
+
+    stats = wl_mod.review("US")
+    assert stats["total"] == 1
+    assert "TRIGGERED" in stats["by_state"]
+
+    alerts = wl_mod.alerts("US")
+    assert any(a["code"] == "BREAKOUT" for a in alerts)
+    assert all(a["ticker"] == "AAA" for a in alerts)
+    # severity filter narrows the list
+    assert len(wl_mod.alerts("US", min_severity="bearish")) <= len(alerts)
+
+
+def test_prune_dry_run_then_apply(wl_mod, monkeypatch):
+    _seed(wl_mod, {"DEAD": ("SEPA", {"added_date": "2025-01-01", "market": "US"})})
+    # strong uptrend then a full collapse -> INVALIDATED
+    closes = list(np.linspace(100, 160, 120)) + list(np.linspace(159, 70, 40))
+    monkeypatch.setattr(wl_mod, "get_enriched", lambda t, period="2y": _make_df(closes))
+    monkeypatch.setattr(wl_mod, "detect_vcp", lambda d: {})
+    wl = wl_mod.track(market="US")
+    assert wl["SEPA"]["DEAD"]["tracking"]["state"] == "INVALIDATED"
+
+    dry = wl_mod.prune("US", apply=False)
+    assert [a["ticker"] for a in dry["archived"]] == ["DEAD"]
+    assert dry["applied"] is False
+    saved = json.loads(wl_mod.WATCHLIST_FILE.read_text(encoding="utf-8"))
+    assert not saved["SEPA"]["DEAD"].get("archived")
+
+    done = wl_mod.prune("US", apply=True)
+    assert done["applied"] is True
+    saved = json.loads(wl_mod.WATCHLIST_FILE.read_text(encoding="utf-8"))
+    assert saved["SEPA"]["DEAD"]["archived"] is True
+    assert saved["SEPA"]["DEAD"]["archive_reason"]
+
