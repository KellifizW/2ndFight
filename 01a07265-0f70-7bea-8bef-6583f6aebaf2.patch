+
+# ═══════════════════════════════════════════════════════════════════════════════
+# 智能跟進（State-Aware Tracking）服務層
+# ═══════════════════════════════════════════════════════════════════════════════
+
+def _days_to_catalyst(ticker: str) -> Optional[int]:
+    """距下次財報/催化劑的天數（取不到就 None，不影響主流程）。"""
+    try:
+        from datetime import date as _date
+
+        from modules.data_pipeline import get_earnings_calendar
+
+        cal = get_earnings_calendar(ticker) or {}
+        nd = cal.get("next_date")
+        if not nd:
+            return None
+        if isinstance(nd, str):
+            nd = datetime.strptime(nd[:10], "%Y-%m-%d").date()
+        return (nd - _date.today()).days
+    except Exception:
+        return None
+
+
+def track(ticker: Optional[str] = None,
+          market: Optional[str] = None,
+          verbose: bool = False) -> dict:
+    """
+    對 watchlist（或單一 ticker）執行智能跟進更新。
+
+    更新內容：
+      • baseline（加入時收盤價）— 缺失時自動補建
+      • 狀態機 BUILDING/READY/TRIGGERED/EXTENDED/INVALIDATED/COLD_WATCH
+      • 多維度訊號（RVOL、回踩 EMA、突破、跌破、跳空、催化劑倒數…）
+      • MFE / MAE / Lead Time / Resolution
+      • Proximity Score 與自動清理建議
+
+    回傳更新後的 watchlist dict。
+    """
+    wl = _load()
+    target_market = _normalize_market(market) if market else None
+    only = ticker.upper().strip() if ticker else None
+
+    updated = 0
+    for s in STRATEGY_KEYS:
+        for tk in list(wl[s].keys()):
+            if only and tk != only:
+                continue
+            entry = wl[s][tk] or {}
+            if target_market and _normalize_market(entry.get("market")) != target_market:
+                continue
+            try:
+                df = get_enriched(tk, period="2y")
+            except Exception as exc:
+                logger.warning("[watchlist] track: data fetch failed for %s: %s", tk, exc)
+                continue
+            if df is None or df.empty:
+                continue
+            try:
+                vcp = detect_vcp(df)
+            except Exception:
+                vcp = None
+            try:
+                wl[s][tk] = tracker.track_entry(
+                    tk, entry, df,
+                    days_to_catalyst=_days_to_catalyst(tk),
+                    vcp=vcp,
+                )
+                updated += 1
+                if verbose:
+                    tr = wl[s][tk].get("tracking", {})
+                    print(f"  {tk:<6} {tr.get('state', '—'):<12} "
+                          f"score={tr.get('proximity_score', 0):<5} "
+                          f"{tr.get('state_reason', '')}")
+            except Exception as exc:
+                logger.warning("[watchlist] track failed for %s: %s", tk, exc)
+
+    if updated:
+        _save(wl)
+    if verbose:
+        print(f"\n  ✓ Tracked {updated} watchlist entries")
+    return wl
+
+
+def tracked_rows(market: Optional[str] = None) -> list:
+    """回傳依 Proximity Score 排序的追蹤列（不重新抓資料，讀持久化狀態）。"""
+    wl = _load()
+    if market:
+        wl = filter_by_market(wl, market)
+    return tracker.rank_entries(wl)
+
+
+def review(market: Optional[str] = None) -> dict:
+    """復盤統計摘要（勝率 / MFE / MAE / Lead Time / 按標籤分組）。"""
+    wl = _load()
+    if market:
+        wl = filter_by_market(wl, market)
+    return tracker.review_stats(wl)
+
+
+def timeline(ticker: str, market: Optional[str] = None) -> dict:
+    """單一標的的完整追蹤時間軸：baseline + 事件日誌 + 快照 + 績效。"""
+    tk = ticker.upper().strip()
+    wl = _load()
+    if market:
+        wl = filter_by_market(wl, market)
+    for s in STRATEGY_KEYS:
+        if tk in wl.get(s, {}):
+            e = wl[s][tk] or {}
+            return {
+                "ticker": tk,
+                "strategy": s,
+                "market": e.get("market", "US"),
+                "added_date": e.get("added_date"),
+                "note": e.get("note", ""),
+                "tags": e.get("tags") or [],
+                "baseline": e.get("baseline") or {},
+                "tracking": e.get("tracking") or {},
+                "events": list(reversed(e.get("events") or [])),
+                "snapshots": list(reversed(e.get("snapshots") or [])),
+            }
+    return {}
+
+
+def prune(market: Optional[str] = None, apply: bool = False) -> dict:
+    """自動清理：INVALIDATED 歸檔為失敗案例、久盤降級 COLD_WATCH。
+
+    apply=False 時只回報建議（dry-run）。
+    """
+    wl = _load()
+    target_market = _normalize_market(market) if market else None
+    archived, cooled = [], []
+
+    for s in STRATEGY_KEYS:
+        for tk in list(wl[s].keys()):
+            entry = wl[s][tk] or {}
+            if target_market and _normalize_market(entry.get("market")) != target_market:
+                continue
+            tr = entry.get("tracking") or {}
+            decision = (tr.get("prune") or {})
+            action = decision.get("action")
+            if action == "ARCHIVE_FAILED":
+                archived.append({"ticker": tk, "strategy": s,
+                                 "reason": decision.get("reason"),
+                                 "performance": tr.get("performance") or {}})
+                if apply:
+                    entry["archived"] = True
+                    entry["archived_at"] = datetime.now().strftime("%Y-%m-%d")
+                    entry["archive_reason"] = decision.get("reason")
+            elif action == "COLD_WATCH":
+                cooled.append({"ticker": tk, "strategy": s,
+                               "reason": decision.get("reason")})
+                if apply:
+                    entry["cold_watch"] = True
+    if apply and (archived or cooled):
+        _save(wl)
+    return {"archived": archived, "cold_watch": cooled, "applied": bool(apply)}
+
+
+def alerts(market: Optional[str] = None, min_severity: str = "info") -> list:
+    """回傳今日值得注意的訊號清單（跨全部觀察標的）。"""
+    order = {"info": 0, "bullish": 1, "warning": 2, "bearish": 3}
+    floor = order.get(min_severity, 0)
+    out = []
+    for row in tracked_rows(market):
+        for sig in row.get("signals") or []:
+            if order.get(sig.get("severity", "info"), 0) < floor:
+                continue
+            out.append({
+                "ticker": row["ticker"],
+                "strategy": row["strategy"],
+                "state": row["state"],
+                "proximity_score": row["proximity_score"],
+                **sig,
+            })
+    out.sort(key=lambda x: (-order.get(x.get("severity", "info"), 0),
+                            -(x.get("proximity_score") or 0)))
+    return out
