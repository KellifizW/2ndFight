+"""
+modules/watchlist_tracker.py
+────────────────────────────
+Watchlist 智能跟進引擎 — State-Aware Watchlist Tracking Engine.
+
+把 Watchlist 由「靜態股票清單」升級為「具狀態感知與量化追蹤能力的自動化監控系統」。
+
+五大功能模組
+    1. 形態生命週期狀態機          → classify_state()
+    2. 多維度動態觸發器             → detect_signals()
+    3. 自動化情境快照與歸因標記      → build_baseline() / build_snapshot() / auto_tags()
+    4. 復盤與量化效能分析           → compute_performance()  (MFE / MAE / Lead Time / Resolution)
+    5. 動態權重排序與自動清理        → proximity_score() / prune_decision()
+
+設計原則
+    • 本模組的核心函式全部是「純函式」：輸入 OHLCV DataFrame + entry dict，
+      輸出 dict。不做網絡 I/O，方便單元測試與回測復用。
+    • 只有 `track_entry()` / `refresh_tracking()` 這層 orchestrator 會呼叫
+      data_pipeline 抓資料。
+"""
+
+from __future__ import annotations
+
+import logging
+import math
+from datetime import date, datetime, timedelta
+from typing import Any, Iterable, Optional
+
+import pandas as pd
+
+logger = logging.getLogger(__name__)
+
+
+# ═══════════════════════════════════════════════════════════════════════════════
+# 常數 / 狀態機定義
+# ═══════════════════════════════════════════════════════════════════════════════
+
+STATE_BUILDING    = "BUILDING"       # 蓄勢 / 盤整中
+STATE_READY       = "READY"          # 臨近觸發點
+STATE_TRIGGERED   = "TRIGGERED"      # 啟動 / 突破
+STATE_EXTENDED    = "EXTENDED"       # 波段延伸 / 獲利期
+STATE_INVALIDATED = "INVALIDATED"    # 形態失效
+STATE_COLD_WATCH  = "COLD_WATCH"     # 降溫歸檔
+
+STATES = (
+    STATE_BUILDING,
+    STATE_READY,
+    STATE_TRIGGERED,
+    STATE_EXTENDED,
+    STATE_INVALIDATED,
+    STATE_COLD_WATCH,
+)
+
+STATE_LABELS = {
+    STATE_BUILDING:    "蓄勢盤整",
+    STATE_READY:       "臨近觸發",
+    STATE_TRIGGERED:   "突破啟動",
+    STATE_EXTENDED:    "波段延伸",
+    STATE_INVALIDATED: "形態失效",
+    STATE_COLD_WATCH:  "冷凍觀察",
+}
+
+STATE_COLORS = {
+    STATE_BUILDING:    "secondary",
+    STATE_READY:       "warning",
+    STATE_TRIGGERED:   "success",
+    STATE_EXTENDED:    "info",
+    STATE_INVALIDATED: "danger",
+    STATE_COLD_WATCH:  "dark",
+}
+
+# 狀態機允許的轉換（用於避免噪音式來回跳動）
+STATE_ORDER = {
+    STATE_COLD_WATCH: 0,
+    STATE_BUILDING: 1,
+    STATE_READY: 2,
+    STATE_TRIGGERED: 3,
+    STATE_EXTENDED: 4,
+    STATE_INVALIDATED: -1,
+}
+
+# ── 門檻參數（可由 trader_config 覆寫） ────────────────────────────────────────
+DEFAULTS = {
+    "READY_ATR_DISTANCE":      2.0,   # 距突破點 ≤ N ATR 視為 READY
+    "TRIGGER_RVOL":            2.0,   # 突破所需相對量能
+    "TRIGGER_RVOL_SOFT":       1.5,   # 弱確認量能
+    "EXTENDED_ATR_FROM_EMA10": 3.0,   # 偏離 10EMA 超過 N ATR = EXTENDED
+    "EXTENDED_PCT_FROM_EMA10": 12.0,  # 或偏離 10EMA 超過 N% = EXTENDED
+    "VOLUME_DRYUP_RATIO":      0.75,  # 5日均量 / 50日均量 < N = 量能乾涸
+    "ATR_CONTRACTION_RATIO":   0.85,  # ATR(14) / ATR(14) 20日前 < N = 波動壓縮
+    "PULLBACK_ATR_TOLERANCE":  0.45,  # 回踩均線容忍距離（ATR 倍數）
+    "COLD_WATCH_DAYS":         20,    # 超過 N 個交易日未突破 → COLD_WATCH
+    "CATALYST_HIGHLIGHT_DAYS": 3,     # 催化劑前 N 天提亮
+    "MAE_STOP_ATR":            2.0,   # MAE 超過 N ATR 視為停損邏輯需檢討
+}
+
+
+def _cfg(key: str) -> float:
+    """讀取門檻參數，允許 trader_config 以 WL_<KEY> 覆寫。"""
+    try:
+        import trader_config as C  # noqa: WPS433 (lazy import, optional)
+
+        val = getattr(C, f"WL_{key}", None)
+        if val is not None:
+            return float(val)
+    except Exception:
+        pass
+    return float(DEFAULTS[key])
+
+
+# ═══════════════════════════════════════════════════════════════════════════════
+# 小工具
+# ═══════════════════════════════════════════════════════════════════════════════
+
+def _f(val: Any) -> Optional[float]:
+    """安全轉 float；NaN / None / 非數值 → None。"""
+    if val is None:
+        return None
+    try:
+        out = float(val)
+    except (TypeError, ValueError):
+        return None
+    if math.isnan(out) or math.isinf(out):
+        return None
+    return out
+
+
+def _round(val: Optional[float], nd: int = 2) -> Optional[float]:
+    v = _f(val)
+    return None if v is None else round(v, nd)
+
+
+def _pct(new: Optional[float], old: Optional[float]) -> Optional[float]:
+    n, o = _f(new), _f(old)
+    if n is None or o is None or o == 0:
+        return None
+    return (n - o) / abs(o) * 100.0
+
+
+def _parse_date(val: Any) -> Optional[date]:
+    if val is None or val == "":
+        return None
+    if isinstance(val, datetime):
+        return val.date()
+    if isinstance(val, date):
+        return val
+    for fmt in ("%Y-%m-%d", "%Y/%m/%d", "%Y-%m-%dT%H:%M:%S", "%Y-%m-%d %H:%M:%S"):
+        try:
+            return datetime.strptime(str(val)[: len(fmt) + 2], fmt).date()
+        except ValueError:
+            continue
+    try:
+        return pd.to_datetime(val).date()
+    except Exception:
+        return None
+
+
+def _ema(series: pd.Series, span: int) -> pd.Series:
+    return series.ewm(span=span, adjust=False).mean()
+
+
+def _atr(df: pd.DataFrame, length: int = 14) -> pd.Series:
+    high, low, close = df["High"], df["Low"], df["Close"]
+    prev = close.shift(1)
+    tr = pd.concat(
+        [(high - low).abs(), (high - prev).abs(), (low - prev).abs()], axis=1
+    ).max(axis=1)
+    return tr.ewm(alpha=1.0 / length, adjust=False).mean()
+
+
+def prepare_frame(df: pd.DataFrame) -> pd.DataFrame:
+    """確保追蹤所需的欄位存在（EMA_10/20 為 tracker 專用，data_pipeline 沒有）。"""
+    if df is None or len(df) == 0:
+        return pd.DataFrame()
+    out = df.copy()
+    if "Close" not in out.columns:
+        return pd.DataFrame()
+    close = out["Close"].astype(float)
+    for col in ("High", "Low"):
+        if col not in out.columns:
+            out[col] = close
+    if "Open" not in out.columns:
+        out["Open"] = close
+    if "Volume" not in out.columns:
+        out["Volume"] = 0.0
+
+    for span in (9, 10, 20, 21, 50, 150, 200):
+        col = f"EMA_{span}"
+        if col not in out.columns or out[col].isna().all():
+            out[col] = _ema(close, span)
+    if "ATR_14" not in out.columns or out["ATR_14"].isna().all():
+        out["ATR_14"] = _atr(out, 14)
+    if "VOL_SMA_50" not in out.columns:
+        out["VOL_SMA_50"] = out["Volume"].rolling(50, min_periods=5).mean()
+    if "VOL_SMA_5" not in out.columns:
+        out["VOL_SMA_5"] = out["Volume"].rolling(5, min_periods=2).mean()
+    return out
+
+
+def _last(df: pd.DataFrame, col: str, offset: int = 0) -> Optional[float]:
+    if col not in df.columns or len(df) <= offset:
+        return None
+    return _f(df[col].iloc[-1 - offset])
+
+
+def _bar_date(df: pd.DataFrame, idx: int = -1) -> Optional[date]:
+    if df is None or len(df) == 0:
+        return None
+    try:
+        return _parse_date(df.index[idx])
+    except Exception:
+        return None
+
+
+# ═══════════════════════════════════════════════════════════════════════════════
+# 模組 3：加入時的情境快照（Baseline / Snapshot）
+# ═══════════════════════════════════════════════════════════════════════════════
+
+def build_baseline(df: pd.DataFrame,
+                   *,
+                   pivot: Optional[float] = None,
+                   added_date: Optional[Any] = None,
+                   note: str = "",
+                   strategy: str = "SEPA") -> dict:
+    """建立「加入 Watchlist 當日」的基準快照。
+
+    這是全部後續追蹤（漲跌幅、MFE/MAE、Lead Time）的錨點。
+    使用最近一個交易日收盤價作為 ref_close。
+    """
+    d = prepare_frame(df)
+    if d.empty:
+        return {
+            "added_date": str(_parse_date(added_date) or date.today()),
+            "ref_close": None,
+            "ref_date": None,
+            "note": note,
+            "strategy": strategy,
+            "pivot": _round(pivot),
+        }
+
+    ref_close = _last(d, "Close")
+    atr = _last(d, "ATR_14")
+    high_252 = _f(d["Close"].tail(252).max())
+
+    baseline = {
+        "added_date":  str(_parse_date(added_date) or date.today()),
+        "ref_date":    str(_bar_date(d) or date.today()),
+        "ref_close":   _round(ref_close),
+        "ref_atr":     _round(atr),
+        "ref_atr_pct": _round(atr / ref_close * 100 if atr and ref_close else None),
+        "ref_ema10":   _round(_last(d, "EMA_10")),
+        "ref_ema20":   _round(_last(d, "EMA_20")),
+        "ref_ema50":   _round(_last(d, "EMA_50")),
+        "ref_volume":  _round(_last(d, "Volume"), 0),
+        "ref_avg_vol_50": _round(_last(d, "VOL_SMA_50"), 0),
+        "ref_high_52w":   _round(high_252),
+        "pivot":       _round(pivot if pivot else _infer_pivot(d)),
+        "swing_low":   _round(_infer_swing_low(d)),
+        "note":        note,
+        "strategy":    strategy,
+    }
+    return baseline
+
+
+def _infer_pivot(df: pd.DataFrame, lookback: int = 40) -> Optional[float]:
+    """在沒有 VCP pivot 時，用近 N 日最高價作為關鍵阻力/突破點。"""
+    if df is None or len(df) < 5:
+        return None
+    window = df["High"].tail(lookback)
+    return _f(window.max())
+
+
+def _infer_swing_low(df: pd.DataFrame, lookback: int = 20) -> Optional[float]:
+    if df is None or len(df) < 5:
+        return None
+    return _f(df["Low"].tail(lookback).min())
+
+
+def build_snapshot(df: pd.DataFrame, *, reason: str = "TRIGGERED") -> dict:
+    """觸發瞬間 Snapshot — 保存當時的量價現場，供日後復盤還原。"""
+    d = prepare_frame(df)
+    if d.empty:
+        return {}
+    close = _last(d, "Close")
+    prev_close = _last(d, "Close", 1)
+    vol = _last(d, "Volume")
+    avg_vol = _last(d, "VOL_SMA_50")
+    atr = _last(d, "ATR_14")
+    return {
+        "reason":      reason,
+        "date":        str(_bar_date(d) or date.today()),
+        "captured_at": datetime.now().isoformat(timespec="seconds"),
+        "close":       _round(close),
+        "open":        _round(_last(d, "Open")),
+        "high":        _round(_last(d, "High")),
+        "low":         _round(_last(d, "Low")),
+        "change_pct":  _round(_pct(close, prev_close)),
+        "gap_pct":     _round(_pct(_last(d, "Open"), prev_close)),
+        "volume":      _round(vol, 0),
+        "rvol":        _round(vol / avg_vol if vol and avg_vol else None),
+        "atr":         _round(atr),
+        "atr_pct":     _round(atr / close * 100 if atr and close else None),
+        "ema10":       _round(_last(d, "EMA_10")),
+        "ema20":       _round(_last(d, "EMA_20")),
+        "ema50":       _round(_last(d, "EMA_50")),
+        "dist_ema10_pct": _round(_pct(close, _last(d, "EMA_10"))),
+        "range_pos": _round(
+            (close - _last(d, "Low")) / (_last(d, "High") - _last(d, "Low")) * 100
+            if _last(d, "High") and _last(d, "Low")
+            and (_last(d, "High") - _last(d, "Low")) > 0 else None
+        ),
+    }
+
+
+# ── 歸因標記 Tagging ──────────────────────────────────────────────────────────
+
+def auto_tags(df: pd.DataFrame, *, strategy: str = "SEPA",
+              vcp: Optional[dict] = None) -> list[str]:
+    """依形態自動賦予標籤，方便日後按策略統計勝率。"""
+    tags: list[str] = []
+    d = prepare_frame(df)
+    if d.empty:
+        return tags
+
+    close = _last(d, "Close")
+    ema10, ema20, ema50 = _last(d, "EMA_10"), _last(d, "EMA_20"), _last(d, "EMA_50")
+    atr = _last(d, "ATR_14")
+    vol, avg_vol = _last(d, "Volume"), _last(d, "VOL_SMA_50")
+    rvol = vol / avg_vol if vol and avg_vol else None
+
+    # VCP
+    if vcp and str(vcp.get("grade", "D")).upper() in ("A", "B"):
+        tags.append("#VCP")
+    elif _is_contracting(d):
+        tags.append("#VCP")
+
+    # High Tight Flag：8 週內急漲 ≥ 60% 後窄幅整理
+    if len(d) >= 45:
+        run_up = _pct(d["Close"].iloc[-1], d["Close"].iloc[-45])
+        recent_range = _f(
+            (d["High"].tail(10).max() - d["Low"].tail(10).min())
+            / d["Close"].iloc[-1] * 100
+        )
+        if run_up and run_up >= 60 and recent_range is not None and recent_range <= 20:
+            tags.append("#HTF")
+
+    # Gap & Go
+    gap = _pct(_last(d, "Open"), _last(d, "Close", 1))
+    if gap is not None and gap >= 3 and rvol and rvol >= 2:
+        tags.append("#GapAndGo")
+
+    # Episodic Pivot：單日大漲 + 爆量
+    chg = _pct(close, _last(d, "Close", 1))
+    if chg is not None and chg >= 8 and rvol and rvol >= 3:
+        tags.append("#EP")
+
+    # 均線多頭排列 / 回調買點
+    if close and ema10 and ema20 and ema50 and ema10 > ema20 > ema50:
+        tags.append("#Stacked")
+    if close and ema20 and atr and abs(close - ema20) <= atr * _cfg("PULLBACK_ATR_TOLERANCE"):
+        tags.append("#Pullback")
+
+    if strategy:
+        tags.append(f"#{strategy}")
+    # 去重且保序
+    return list(dict.fromkeys(tags))
+
+
+def _is_contracting(df: pd.DataFrame) -> bool:
+    """ATR 壓縮判定（Volatility Contraction）。"""
+    if df is None or len(df) < 40 or "ATR_14" not in df.columns:
+        return False
+    now = _f(df["ATR_14"].iloc[-1])
+    prev = _f(df["ATR_14"].iloc[-21])
+    if now is None or prev in (None, 0):
+        return False
+    return now / prev < _cfg("ATR_CONTRACTION_RATIO")
+
+
+# ═══════════════════════════════════════════════════════════════════════════════
+# EMA 趨勢線分析
+# ═══════════════════════════════════════════════════════════════════════════════
+
+def analyze_ema_trend(df: pd.DataFrame) -> dict:
+    """EMA 趨勢線結構分析：排列、斜率、乖離、緊密度。"""
+    d = prepare_frame(df)
+    if d.empty:
+        return {}
+
+    close = _last(d, "Close")
+    e10, e20, e50 = _last(d, "EMA_10"), _last(d, "EMA_20"), _last(d, "EMA_50")
+    e150 = _last(d, "EMA_150")
+    atr = _last(d, "ATR_14")
+
+    def slope(col: str, window: int = 10) -> Optional[float]:
+        if col not in d.columns or len(d) <= window:
+            return None
+        return _pct(d[col].iloc[-1], d[col].iloc[-1 - window])
+
+    stacked = bool(close and e10 and e20 and e50 and close > e10 > e20 > e50)
+    bearish = bool(close and e10 and e20 and e50 and close < e10 < e20 < e50)
+
+    # 均線緊密度：三條 EMA 的最大離散度 / 價格
+    tightness = None
+    emas = [v for v in (e10, e20, e50) if v]
+    if len(emas) == 3 and close:
+        tightness = (max(emas) - min(emas)) / close * 100
+
+    if stacked:
+        trend = "UP"
+    elif bearish:
+        trend = "DOWN"
+    elif close and e20 and close > e20:
+        trend = "NEUTRAL_UP"
+    else:
+        trend = "NEUTRAL_DOWN"
+
+    return {
+        "trend": trend,
+        "stacked": stacked,
+        "ema10": _round(e10),
+        "ema20": _round(e20),
+        "ema50": _round(e50),
+        "ema150": _round(e150),
+        "dist_ema10_pct": _round(_pct(close, e10)),
+        "dist_ema20_pct": _round(_pct(close, e20)),
+        "dist_ema50_pct": _round(_pct(close, e50)),
+        "dist_ema10_atr": _round((close - e10) / atr if close and e10 and atr else None),
+        "slope_ema10_pct": _round(slope("EMA_10")),
+        "slope_ema20_pct": _round(slope("EMA_20")),
+        "slope_ema50_pct": _round(slope("EMA_50", 20)),
+        "tightness_pct": _round(tightness),
+        "above_ema10": bool(close and e10 and close > e10),
+        "above_ema20": bool(close and e20 and close > e20),
+        "above_ema50": bool(close and e50 and close > e50),
+    }
+
+
+# ═══════════════════════════════════════════════════════════════════════════════
+# 模組 2：多維度動態觸發器
+# ═══════════════════════════════════════════════════════════════════════════════
+
+SIGNAL_SEVERITY = {"bullish": "success", "warning": "warning", "bearish": "danger", "info": "info"}
+
+
+def _sig(code: str, label: str, severity: str, detail: str = "", **extra) -> dict:
+    out = {"code": code, "label": label, "severity": severity, "detail": detail}
+    out.update(extra)
+    return out
+
+
+def detect_signals(df: pd.DataFrame,
+                   *,
+                   baseline: Optional[dict] = None,
+                   pivot: Optional[float] = None,
+                   days_to_catalyst: Optional[int] = None) -> list[dict]:
+    """多維度事件觸發器：量價異動 + 均線回踩 + 結構破壞 + 催化劑倒數。"""
+    d = prepare_frame(df)
+    if d.empty:
+        return []
+
+    baseline = baseline or {}
+    sigs: list[dict] = []
+
+    close = _last(d, "Close")
+    open_ = _last(d, "Open")
+    low = _last(d, "Low")
+    high = _last(d, "High")
+    prev_close = _last(d, "Close", 1)
+    e10, e20, e50 = _last(d, "EMA_10"), _last(d, "EMA_20"), _last(d, "EMA_50")
+    atr = _last(d, "ATR_14")
+    vol, avg_vol = _last(d, "Volume"), _last(d, "VOL_SMA_50")
+    vol5 = _last(d, "VOL_SMA_5")
+    rvol = vol / avg_vol if vol and avg_vol else None
+    pivot = _f(pivot) or _f(baseline.get("pivot")) or _infer_pivot(d)
+    tol = _cfg("PULLBACK_ATR_TOLERANCE")
+
+    # ── 量價異動 ──────────────────────────────────────────────────────────
+    if rvol is not None and rvol >= _cfg("TRIGGER_RVOL"):
+        sigs.append(_sig("RVOL_SURGE", "RVOL 突增",
+                         "bullish" if (close or 0) >= (prev_close or 0) else "warning",
+                         f"相對成交量 {rvol:.1f}x（≥ {_cfg('TRIGGER_RVOL'):.1f}x）",
+                         value=_round(rvol)))
+
+    if vol5 and avg_vol and vol5 / avg_vol < _cfg("VOLUME_DRYUP_RATIO"):
+        sigs.append(_sig("VOLUME_DRYUP", "量能乾涸", "info",
+                         f"5日均量僅為 50日均量的 {vol5 / avg_vol:.0%}",
+                         value=_round(vol5 / avg_vol)))
+
+    if _is_contracting(d):
+        sigs.append(_sig("ATR_COMPRESSION", "波動壓縮 VCP", "info",
+                         "ATR(14) 較 20 日前收縮，形態收窄中"))
+
+    gap = _pct(open_, prev_close)
+    if gap is not None and gap >= 3:
+        sigs.append(_sig("GAP_UP", "跳空缺口", "bullish",
+                         f"開盤跳空 +{gap:.1f}%", value=_round(gap)))
+    elif gap is not None and gap <= -3:
+        sigs.append(_sig("GAP_DOWN", "向下跳空", "bearish",
+                         f"開盤跳空 {gap:.1f}%", value=_round(gap)))
+
+    # ── 突破 / 回踩 ───────────────────────────────────────────────────────
+    if pivot and close:
+        prev_below = prev_close is not None and prev_close <= pivot
+        if close > pivot and prev_below:
+            sev = "bullish" if (rvol or 0) >= _cfg("TRIGGER_RVOL_SOFT") else "warning"
+            sigs.append(_sig("BREAKOUT", "突破關鍵位", sev,
+                             f"收盤 {close:.2f} 突破 pivot {pivot:.2f}"
+                             + (f"，RVOL {rvol:.1f}x" if rvol else ""),
+                             value=_round(pivot)))
+        elif close <= pivot and atr:
+            dist_atr = (pivot - close) / atr
+            if dist_atr <= _cfg("READY_ATR_DISTANCE"):
+                sigs.append(_sig("NEAR_PIVOT", "臨近突破點", "warning",
+                                 f"距 pivot {pivot:.2f} 僅 {dist_atr:.2f} ATR",
+                                 value=_round(dist_atr)))
+
+    # 均線回踩支撐（回踩 + 收復 = 支撐訊號）
+    for name, ema_val, code in (("10EMA", e10, "PULLBACK_EMA10"),
+                                ("20EMA", e20, "PULLBACK_EMA20"),
+                                ("50EMA", e50, "PULLBACK_EMA50")):
+        if not (ema_val and close and low and atr):
+            continue
+        touched = low <= ema_val + atr * tol
+        reclaimed = close >= ema_val
+        if touched and reclaimed:
+            bullish_bar = close >= (open_ or close)
+            sigs.append(_sig(code, f"回踩 {name} 獲支撐",
+                             "bullish" if bullish_bar else "info",
+                             f"最低 {low:.2f} 觸及 {name} {ema_val:.2f} 後收復於 {close:.2f}",
+                             value=_round(ema_val)))
+            break  # 只報最快的一條
+
+    # 均線失守
+    if e20 and close and close < e20 and prev_close and prev_close >= e20:
+        sigs.append(_sig("LOSE_EMA20", "跌破 20EMA", "warning",
+                         f"收盤 {close:.2f} < 20EMA {e20:.2f}"))
+    if e50 and close and close < e50 and prev_close and prev_close >= e50:
+        sigs.append(_sig("LOSE_EMA50", "跌破 50EMA", "bearish",
+                         f"收盤 {close:.2f} < 50EMA {e50:.2f} — 結構受損"))
+
+    swing_low = _f(baseline.get("swing_low")) or _infer_swing_low(d)
+    if swing_low and close and close < swing_low:
+        sigs.append(_sig("SWING_LOW_BREAK", "跌破結構低點", "bearish",
+                         f"收盤 {close:.2f} 跌穿 swing low {swing_low:.2f}"))
+
+    # 延伸過遠
+    if close and e10 and atr:
+        ext_atr = (close - e10) / atr
+        ext_pct = _pct(close, e10) or 0
+        if ext_atr >= _cfg("EXTENDED_ATR_FROM_EMA10") or ext_pct >= _cfg("EXTENDED_PCT_FROM_EMA10"):
+            sigs.append(_sig("EXTENDED_FROM_EMA10", "偏離 10EMA 過遠", "warning",
+                             f"距 10EMA {ext_pct:.1f}%（{ext_atr:.1f} ATR），追高風險高",
+                             value=_round(ext_atr)))
+
+    # 52 週新高
+    if len(d) >= 60 and close:
+        hi = _f(d["Close"].tail(252).max())
+        if hi and close >= hi - 1e-9:
+            sigs.append(_sig("NEW_52W_HIGH", "創 52 週新高", "bullish",
+                             f"收盤 {close:.2f} 創期間新高"))
+
+    # 內包日 / 窄幅整理
+    prev_high, prev_low = _last(d, "High", 1), _last(d, "Low", 1)
+    if high and low and prev_high and prev_low and high <= prev_high and low >= prev_low:
+        sigs.append(_sig("INSIDE_DAY", "內包日", "info", "區間收窄，蓄勢待發"))
+
+    # ── 催化劑倒數 ────────────────────────────────────────────────────────
+    if days_to_catalyst is not None:
+        try:
+            dtc = int(days_to_catalyst)
+        except (TypeError, ValueError):
+            dtc = None
+        if dtc is not None and 0 <= dtc <= _cfg("CATALYST_HIGHLIGHT_DAYS"):
+            sigs.append(_sig("CATALYST_IMMINENT", "催化劑臨近", "warning",
+                             f"距財報/事件僅 {dtc} 天", value=dtc))
+
+    return sigs
+
+
+# ═══════════════════════════════════════════════════════════════════════════════
+# 模組 1：狀態機
+# ═══════════════════════════════════════════════════════════════════════════════
+
+def classify_state(df: pd.DataFrame,
+                   *,
+                   baseline: Optional[dict] = None,
+                   prev_state: Optional[str] = None,
+                   pivot: Optional[float] = None,
+                   days_since_added: Optional[int] = None) -> dict:
+    """判定形態生命週期狀態。回傳 {state, reason, ...}。"""
+    d = prepare_frame(df)
+    if d.empty:
+        return {"state": prev_state or STATE_BUILDING, "reason": "無足夠資料", "changed": False}
+
+    baseline = baseline or {}
+    close = _last(d, "Close")
+    e10, e20, e50 = _last(d, "EMA_10"), _last(d, "EMA_20"), _last(d, "EMA_50")
+    atr = _last(d, "ATR_14")
+    vol, avg_vol = _last(d, "Volume"), _last(d, "VOL_SMA_50")
+    rvol = vol / avg_vol if vol and avg_vol else None
+    pivot = _f(pivot) or _f(baseline.get("pivot")) or _infer_pivot(d)
+    swing_low = _f(baseline.get("swing_low")) or _infer_swing_low(d)
+
+    state, reason = STATE_BUILDING, "價格於區間內整理"
+
+    # 1) INVALIDATED — 結構破壞優先於一切
+    if close and e50 and close < e50 and (
+        (swing_low and close < swing_low) or (e20 and e50 and e20 < e50)
+    ):
+        return _state_result(STATE_INVALIDATED,
+                             f"收盤 {close:.2f} 跌破 50EMA 且結構受損", prev_state)
+    if swing_low and close and close < swing_low * 0.99:
+        return _state_result(STATE_INVALIDATED,
+                             f"收盤 {close:.2f} 跌穿結構支撐 {swing_low:.2f}", prev_state)
+
+    # 2) EXTENDED — 突破後偏離均線過遠
+    ext_atr = (close - e10) / atr if close and e10 and atr else None
+    ext_pct = _pct(close, e10)
+    is_extended = (
+        (ext_atr is not None and ext_atr >= _cfg("EXTENDED_ATR_FROM_EMA10"))
+        or (ext_pct is not None and ext_pct >= _cfg("EXTENDED_PCT_FROM_EMA10"))
+    )
+    broke_out = bool(pivot and close and close > pivot)
+
+    # 注意：只有「先前已經 TRIGGERED/EXTENDED」才會進入延伸期。
+    # 當日剛突破的標的即使乖離大，仍應標記為 TRIGGERED（啟動日），
+    # 否則會錯過進場時機並漏掉 trigger snapshot。
+    already_running = prev_state in (STATE_TRIGGERED, STATE_EXTENDED)
+    if broke_out and is_extended and already_running:
+        return _state_result(STATE_EXTENDED,
+                             f"已突破且偏離 10EMA {ext_pct:.1f}%，進入延伸期", prev_state)
+
+    # 3) TRIGGERED — 突破關鍵位 + 量能確認
+    if broke_out:
+        gap = _pct(_last(d, "Open"), _last(d, "Close", 1))
+        confirmed = (rvol is not None and rvol >= _cfg("TRIGGER_RVOL")) or (gap or 0) >= 3
+        if confirmed:
+            return _state_result(STATE_TRIGGERED,
+                                 f"突破 {pivot:.2f}"
+                                 + (f"，RVOL {rvol:.1f}x" if rvol else "")
+                                 + (f"，跳空 +{gap:.1f}%" if gap and gap >= 3 else ""),
+                                 prev_state)
+        # 突破但量能不足 → 已經 TRIGGERED 過就維持，否則算 READY
+        if prev_state in (STATE_TRIGGERED, STATE_EXTENDED):
+            return _state_result(prev_state, "維持突破後走勢（量能未再放大）", prev_state)
+        return _state_result(STATE_READY, f"價格站上 {pivot:.2f} 但量能未確認", prev_state)
+
+    # 4) READY — 距突破點 ≤ N ATR 且量能收縮
+    if pivot and close and atr:
+        dist_atr = (pivot - close) / atr
+        vol5 = _last(d, "VOL_SMA_5")
+        dry = bool(vol5 and avg_vol and vol5 / avg_vol < _cfg("VOLUME_DRYUP_RATIO"))
+        if 0 <= dist_atr <= _cfg("READY_ATR_DISTANCE"):
+            reason = f"距 pivot {pivot:.2f} 僅 {dist_atr:.2f} ATR" + ("，量能乾涸" if dry else "")
+            return _state_result(STATE_READY, reason, prev_state)
+
+    # 5) COLD_WATCH — 太久未發動且死寂
+    cold_days = _cfg("COLD_WATCH_DAYS")
+    if days_since_added is not None and days_since_added >= cold_days:
+        vol5 = _last(d, "VOL_SMA_5")
+        quiet = bool(vol5 and avg_vol and vol5 / avg_vol < _cfg("VOLUME_DRYUP_RATIO"))
+        if quiet and prev_state not in (STATE_TRIGGERED, STATE_EXTENDED):
+            return _state_result(STATE_COLD_WATCH,
+                                 f"加入 {days_since_added} 個交易日未突破且量能死寂", prev_state)
+
+    # 6) BUILDING（預設）
+    if _is_contracting(d):
+        reason = "波動收縮中（ATR 壓縮），蓄勢待發"
+    return _state_result(state, reason, prev_state)
+
+
+def _state_result(state: str, reason: str, prev_state: Optional[str]) -> dict:
+    return {
+        "state": state,
+        "state_label": STATE_LABELS.get(state, state),
+        "state_color": STATE_COLORS.get(state, "secondary"),
+        "reason": reason,
+        "prev_state": prev_state,
+        "changed": bool(prev_state and prev_state != state),
+    }
+
+
+# ═══════════════════════════════════════════════════════════════════════════════
+# 模組 4：復盤與量化效能分析（MFE / MAE / Lead Time / Resolution）
+# ═══════════════════════════════════════════════════════════════════════════════
+
+RESOLUTION_PENDING       = "PENDING"
+RESOLUTION_CLEAN_BREAK   = "CLEAN_BREAKOUT"
+RESOLUTION_FALSE_BREAK   = "FALSE_BREAKOUT"
+RESOLUTION_IMMEDIATE_DUMP = "IMMEDIATE_DUMP"
+RESOLUTION_STALLED       = "STALLED"
+
+RESOLUTION_LABELS = {
+    RESOLUTION_PENDING:        "追蹤中",
+    RESOLUTION_CLEAN_BREAK:    "乾淨突破",
+    RESOLUTION_FALSE_BREAK:    "假突破",
+    RESOLUTION_IMMEDIATE_DUMP: "即時崩跌",
+    RESOLUTION_STALLED:        "久盤不發",
+}
+
+
+def compute_performance(df: pd.DataFrame, baseline: dict,
+                        *, trigger_date: Optional[Any] = None) -> dict:
+    """自 baseline 起計的績效追蹤：漲跌幅、MFE / MAE、Lead Time。"""
+    d = prepare_frame(df)
+    baseline = baseline or {}
+    ref_close = _f(baseline.get("ref_close"))
+    ref_date = _parse_date(baseline.get("ref_date") or baseline.get("added_date"))
+
+    out: dict[str, Any] = {
+        "ref_close": _round(ref_close),
+        "ref_date": str(ref_date) if ref_date else None,
+        "last_close": None,
+        "last_date": None,
+        "since_added_pct": None,
+        "bars_tracked": 0,
+        "calendar_days": None,
+        "mfe_pct": None, "mfe_date": None,
+        "mae_pct": None, "mae_date": None,
+        "mfe_atr": None, "mae_atr": None,
+        "lead_time_days": None,
+    }
+    if d.empty or ref_close is None:
+        return out
+
+    last_close = _last(d, "Close")
+    last_date = _bar_date(d)
+    out["last_close"] = _round(last_close)
+    out["last_date"] = str(last_date) if last_date else None
+    out["since_added_pct"] = _round(_pct(last_close, ref_close))
+
+    # 只取 baseline 之後的 K 線
+    window = d
+    if ref_date is not None:
+        try:
+            idx = pd.to_datetime(pd.Series(d.index)).dt.date
+            mask = (idx >= ref_date).to_numpy()
+            if mask.any():
+                window = d.loc[mask]
+        except Exception:
+            window = d
+
+    if len(window) == 0:
+        return out
+
+    out["bars_tracked"] = int(len(window))
+    if ref_date and last_date:
+        out["calendar_days"] = (last_date - ref_date).days
+
+    highs, lows = window["High"], window["Low"]
+    mfe_price = _f(highs.max())
+    mae_price = _f(lows.min())
+    out["mfe_pct"] = _round(_pct(mfe_price, ref_close))
+    out["mae_pct"] = _round(_pct(mae_price, ref_close))
+    try:
+        out["mfe_date"] = str(_parse_date(window.index[highs.to_numpy().argmax()]))
+        out["mae_date"] = str(_parse_date(window.index[lows.to_numpy().argmin()]))
+    except Exception:
+        pass
+
+    ref_atr = _f(baseline.get("ref_atr")) or _last(d, "ATR_14")
+    if ref_atr:
+        out["mfe_atr"] = _round((mfe_price - ref_close) / ref_atr if mfe_price else None)
+        out["mae_atr"] = _round((mae_price - ref_close) / ref_atr if mae_price else None)
+
+    # Lead Time：加入 → 正式突破（TRIGGERED）的交易日數
+    tdate = _parse_date(trigger_date)
+    if tdate and ref_date:
+        try:
+            idx = pd.to_datetime(pd.Series(window.index)).dt.date
+            bars = int(((idx >= ref_date) & (idx <= tdate)).sum())
+            out["lead_time_days"] = max(bars - 1, 0)
+        except Exception:
+            out["lead_time_days"] = (tdate - ref_date).days
+    return out
+
+
+def classify_resolution(state: str,
+                        performance: dict,
+                        *,
+                        ever_triggered: bool = False,
+                        days_since_added: Optional[int] = None) -> dict:
+    """統計形態最終走勢類型，作為策略勝率統計依據。"""
+    perf = performance or {}
+    mfe = _f(perf.get("mfe_pct"))
+    mae = _f(perf.get("mae_pct"))
+    since = _f(perf.get("since_added_pct"))
+
+    if state == STATE_INVALIDATED:
+        if ever_triggered:
+            res = RESOLUTION_FALSE_BREAK
+        elif since is not None and since <= -8:
+            res = RESOLUTION_IMMEDIATE_DUMP
+        else:
+            res = RESOLUTION_IMMEDIATE_DUMP if (mae or 0) <= -10 else RESOLUTION_FALSE_BREAK
+    elif state in (STATE_TRIGGERED, STATE_EXTENDED):
+        res = RESOLUTION_CLEAN_BREAK if (since or 0) > 0 else RESOLUTION_FALSE_BREAK
+    elif state == STATE_COLD_WATCH or (days_since_added or 0) >= _cfg("COLD_WATCH_DAYS") * 1.5:
+        res = RESOLUTION_STALLED
+    else:
+        res = RESOLUTION_PENDING
+
+    notes = []
+    if mae is not None and mae <= -_cfg("MAE_STOP_ATR") * 3:
+        notes.append("MAE 過深，買點或停損設定需檢討")
+    if mfe is not None and since is not None and mfe - since >= 15:
+        notes.append(f"曾有 {mfe:.1f}% 潛在獲利未鎖定，考慮加強移動停利")
+    if (perf.get("lead_time_days") or 0) > _cfg("COLD_WATCH_DAYS"):
+        notes.append("潛伏期偏長，加入時機可再延後以節省資金佔用")
+
+    return {
+        "resolution": res,
+        "resolution_label": RESOLUTION_LABELS.get(res, res),
+        "review_notes": notes,
+    }
+
+
+# ═══════════════════════════════════════════════════════════════════════════════
+# 模組 5：動態權重排序（Proximity Score）與自動清理
+# ═══════════════════════════════════════════════════════════════════════════════
+
+def proximity_score(df: pd.DataFrame,
+                    *,
+                    baseline: Optional[dict] = None,
+                    state: Optional[str] = None,
+                    pivot: Optional[float] = None,
+                    days_to_catalyst: Optional[int] = None,
+                    ema_trend: Optional[dict] = None) -> dict:
+    """
+    動態優先級評分（0–100）。
+        Score = f(距突破點 ATR 距離, 均線緊密程度, RVOL, 催化劑天數, 趨勢結構)
+    分數越高 = 越接近發動，越應該排在清單最上方。
+    """
+    d = prepare_frame(df)
+    if d.empty:
+        return {"score": 0.0, "breakdown": {}}
+
+    baseline = baseline or {}
+    ema_trend = ema_trend or analyze_ema_trend(d)
+    close = _last(d, "Close")
+    atr = _last(d, "ATR_14")
+    vol, avg_vol = _last(d, "Volume"), _last(d, "VOL_SMA_50")
+    rvol = vol / avg_vol if vol and avg_vol else None
+    pivot = _f(pivot) or _f(baseline.get("pivot")) or _infer_pivot(d)
+
+    bd: dict[str, float] = {}
+
+    # 1) 距突破點的 ATR 距離（35 分）
+    if pivot and close and atr:
+        dist_atr = (pivot - close) / atr
+        if dist_atr <= 0:
+            bd["distance"] = 35.0                       # 已突破
+        else:
+            bd["distance"] = max(0.0, 35.0 * (1 - dist_atr / 4.0))
+    else:
+        bd["distance"] = 10.0
+
+    # 2) 均線緊密程度（20 分）：越緊越高
+    tight = _f(ema_trend.get("tightness_pct"))
+    if tight is not None:
+        bd["tightness"] = max(0.0, 20.0 * (1 - min(tight, 15.0) / 15.0))
+    else:
+        bd["tightness"] = 8.0
+
+    # 3) 量能（20 分）：RVOL 高（發動）或極低（乾涸蓄勢）都加分
+    if rvol is not None:
+        if rvol >= _cfg("TRIGGER_RVOL"):
+            bd["volume"] = 20.0
+        elif rvol >= 1.2:
+            bd["volume"] = 12.0
+        elif rvol <= 0.7:
+            bd["volume"] = 14.0                          # dry-up 蓄勢
+        else:
+            bd["volume"] = 8.0
+    else:
+        bd["volume"] = 6.0
+
+    # 4) 催化劑倒數（15 分）
+    if days_to_catalyst is not None and days_to_catalyst >= 0:
+        bd["catalyst"] = max(0.0, 15.0 * (1 - min(int(days_to_catalyst), 10) / 10.0))
+    else:
+        bd["catalyst"] = 0.0
+
+    # 5) 趨勢結構（10 分）
+    trend = ema_trend.get("trend")
+    bd["trend"] = {"UP": 10.0, "NEUTRAL_UP": 6.0, "NEUTRAL_DOWN": 2.0, "DOWN": 0.0}.get(trend, 4.0)
+
+    # 狀態加權
+    mult = {
+        STATE_READY: 1.10,
+        STATE_TRIGGERED: 1.05,
+        STATE_BUILDING: 1.00,
+        STATE_EXTENDED: 0.75,
+        STATE_COLD_WATCH: 0.50,
+        STATE_INVALIDATED: 0.20,
+    }.get(state or STATE_BUILDING, 1.0)
+
+    raw = sum(bd.values()) * mult
+    score = round(min(100.0, max(0.0, raw)), 1)
+    return {"score": score, "breakdown": {k: round(v, 1) for k, v in bd.items()},
+            "state_multiplier": mult}
+
+
+def prune_decision(state: str,
+                   *,
+                   days_since_added: Optional[int] = None,
+                   performance: Optional[dict] = None) -> dict:
+    """自動清理與歸檔建議。"""
+    perf = performance or {}
+    if state == STATE_INVALIDATED:
+        return {"action": "ARCHIVE_FAILED", "label": "劃掉並歸檔為失敗案例",
+                "reason": "跌破防守位，形態失效", "auto": True}
+    if state == STATE_COLD_WATCH:
+        return {"action": "COLD_WATCH", "label": "降級至冷凍觀察",
+                "reason": f"{days_since_added or '?'} 個交易日未突破且量能死寂", "auto": True}
+    if state == STATE_EXTENDED:
+        return {"action": "TAKE_PROFIT_WATCH", "label": "延伸期，勿追高",
+                "reason": "偏離 10EMA 過遠，等待回踩", "auto": False}
+    if state == STATE_TRIGGERED:
+        return {"action": "PROMOTE", "label": "已啟動，考慮進場/加倉",
+                "reason": "突破且量能確認", "auto": False}
+    return {"action": "KEEP", "label": "維持觀察", "reason": "形態仍在建構中", "auto": False}
+
+
+# ═══════════════════════════════════════════════════════════════════════════════
+# Orchestrator：把一個 watchlist entry 更新為 state-aware 追蹤物件
+# ═══════════════════════════════════════════════════════════════════════════════
+
+MAX_EVENTS = 120
+
+
+def track_entry(ticker: str,
+                entry: dict,
+                df: pd.DataFrame,
+                *,
+                days_to_catalyst: Optional[int] = None,
+                vcp: Optional[dict] = None,
+                today: Optional[Any] = None) -> dict:
+    """
+    以最新 K 線更新單一 watchlist entry 的追蹤狀態。
+
+    回傳「更新後的 entry」（不會就地修改輸入 dict）。
+    entry 內新增/更新的欄位：
+        baseline, tracking, events, snapshots, tags, state, proximity_score
+    """
+    e = dict(entry or {})
+    d = prepare_frame(df)
+    today_d = _parse_date(today) or date.today()
+
+    # ── baseline：首次追蹤時建立（記下加入當時/最近交易日收盤價） ──────────
+    baseline = e.get("baseline") or {}
+    if not baseline.get("ref_close"):
+        baseline = build_baseline(
+            d,
+            pivot=e.get("pivot") or e.get("pivot_price"),
+            added_date=e.get("added_date") or today_d,
+            note=e.get("note", ""),
+            strategy=e.get("strategy", "SEPA"),
+        )
+        # 保留原本已記錄的加入價（若存在）
+        if e.get("price") and not baseline.get("ref_close"):
+            baseline["ref_close"] = _round(e["price"])
+    e["baseline"] = baseline
+
+    if d.empty:
+        e.setdefault("tracking", {})
+        e["tracking"]["error"] = "no price data"
+        return e
+
+    prev_tracking = e.get("tracking") or {}
+
+    # 狀態機必須「每根 K 線只前進一次」：若本次更新處理的仍是同一根 K 線
+    # （例如同日重跑 refresh），要以「上一根 K 線收盤時的狀態」重新判定，
+    # 否則同日重跑會讓 TRIGGERED 自己滾動成 EXTENDED。
+    bar_day_now = str(_bar_date(d) or today_d)
+    same_bar = prev_tracking.get("last_bar_date") == bar_day_now
+    prev_state = (prev_tracking.get("prev_state") if same_bar
+                  else prev_tracking.get("state"))
+    pivot = _f(e.get("pivot")) or _f(e.get("pivot_price")) or _f(baseline.get("pivot"))
+
+    # 交易日數（以 baseline 之後的 K 線根數計）
+    ref_date = _parse_date(baseline.get("ref_date") or baseline.get("added_date"))
+    days_since_added = None
+    if ref_date is not None:
+        try:
+            idx = pd.to_datetime(pd.Series(d.index)).dt.date
+            days_since_added = int((idx > ref_date).sum())
+        except Exception:
+            days_since_added = (today_d - ref_date).days
+
+    ema_trend = analyze_ema_trend(d)
+    signals = detect_signals(d, baseline=baseline, pivot=pivot,
+                             days_to_catalyst=days_to_catalyst)
+    st = classify_state(d, baseline=baseline, prev_state=prev_state,
+                        pivot=pivot, days_since_added=days_since_added)
+
+    # 一旦 TRIGGERED 過就記住（供 Lead Time / Resolution 使用）
+    trigger_date = prev_tracking.get("trigger_date")
+    ever_triggered = bool(prev_tracking.get("ever_triggered")) or st["state"] in (
+        STATE_TRIGGERED, STATE_EXTENDED
+    )
+    if st["state"] == STATE_TRIGGERED and not trigger_date:
+        trigger_date = str(_bar_date(d) or today_d)
+
+    perf = compute_performance(d, baseline, trigger_date=trigger_date)
+    resolution = classify_resolution(st["state"], perf,
+                                     ever_triggered=ever_triggered,
+                                     days_since_added=days_since_added)
+    score = proximity_score(d, baseline=baseline, state=st["state"], pivot=pivot,
+                            days_to_catalyst=days_to_catalyst, ema_trend=ema_trend)
+    prune = prune_decision(st["state"], days_since_added=days_since_added,
+                           performance=perf)
+
+    # ── 事件日誌（去重：同一日同一 code 只記一次） ─────────────────────────
+    bar_day = bar_day_now
+    events = list(e.get("events") or [])
+    seen = {(ev.get("date"), ev.get("code")) for ev in events}
+    for s in signals:
+        key = (bar_day, s["code"])
+        if key in seen:
+            continue
+        events.append({"date": bar_day, **s})
+        seen.add(key)
+    if st.get("changed"):
+        key = (bar_day, f"STATE_{st['state']}")
+        if key not in seen:
+            events.append({
+                "date": bar_day,
+                "code": f"STATE_{st['state']}",
+                "label": f"狀態轉換 {prev_state} → {st['state']}",
+                "severity": "info" if st["state"] != STATE_INVALIDATED else "danger",
+                "detail": st["reason"],
+            })
+    events = events[-MAX_EVENTS:]
+    e["events"] = events
+
+    # ── 觸發瞬間 Snapshot ─────────────────────────────────────────────────
+    snapshots = list(e.get("snapshots") or [])
+    if st["state"] == STATE_TRIGGERED and st.get("changed"):
+        snap = build_snapshot(d, reason="TRIGGERED")
+        if snap and not any(x.get("date") == snap.get("date")
+                            and x.get("reason") == "TRIGGERED" for x in snapshots):
+            snapshots.append(snap)
+    if st["state"] == STATE_INVALIDATED and st.get("changed"):
+        snap = build_snapshot(d, reason="INVALIDATED")
+        if snap and not any(x.get("date") == snap.get("date")
+                            and x.get("reason") == "INVALIDATED" for x in snapshots):
+            snapshots.append(snap)
+    e["snapshots"] = snapshots[-20:]
+
+    # ── Tagging ───────────────────────────────────────────────────────────
+    manual_tags = [t for t in (e.get("tags") or []) if str(t).startswith("#") and
+                   str(t) not in auto_tags(d, strategy=e.get("strategy", "SEPA"), vcp=vcp)]
+    e["tags"] = list(dict.fromkeys(
+        auto_tags(d, strategy=e.get("strategy", "SEPA"), vcp=vcp) + manual_tags
+    ))
+
+    close = _last(d, "Close")
+    vol, avg_vol = _last(d, "Volume"), _last(d, "VOL_SMA_50")
+
+    e["tracking"] = {
+        "updated_at":        datetime.now().isoformat(timespec="seconds"),
+        "last_bar_date":     bar_day,
+        "state":             st["state"],
+        "state_label":       st["state_label"],
+        "state_color":       st["state_color"],
+        "state_reason":      st["reason"],
+        "state_changed":     bool(st.get("changed")),
+        "prev_state":        prev_state,
+        "ever_triggered":    ever_triggered,
+        "trigger_date":      trigger_date,
+        "days_since_added":  days_since_added,
+        "days_to_catalyst":  days_to_catalyst,
+        "pivot":             _round(pivot),
+        "last_close":        _round(close),
+        "rvol":              _round(vol / avg_vol if vol and avg_vol else None),
+        "atr":               _round(_last(d, "ATR_14")),
+        "ema":               ema_trend,
+        "performance":       perf,
+        "resolution":        resolution["resolution"],
+        "resolution_label":  resolution["resolution_label"],
+        "review_notes":      resolution["review_notes"],
+        "signals":           signals,
+        "signal_codes":      [s["code"] for s in signals],
+        "proximity_score":   score["score"],
+        "score_breakdown":   score["breakdown"],
+        "prune":             prune,
+    }
+
+    # 對外扁平欄位（方便舊 UI / API 直接讀）
+    e["state"] = st["state"]
+    e["proximity_score"] = score["score"]
+    e["since_added_pct"] = perf.get("since_added_pct")
+    e["price"] = _round(close)
+    e["last_updated"] = str(today_d)
+    if pivot:
+        e["pivot"] = _round(pivot)
+        e["pivot_price"] = _round(pivot)
+    return e
+
+
+def rank_entries(wl: dict) -> list[dict]:
+    """把 SEPA/QM/ML 三桶攤平，依 proximity_score 由高至低排序。"""
+    rows: list[dict] = []
+    for strategy in ("SEPA", "QM", "ML"):
+        for ticker, entry in (wl.get(strategy) or {}).items():
+            e = dict(entry or {})
+            tr = e.get("tracking") or {}
+            rows.append({
+                "ticker": ticker,
+                "strategy": strategy,
+                "market": e.get("market", "US"),
+                "state": tr.get("state") or e.get("state") or STATE_BUILDING,
+                "state_label": tr.get("state_label"),
+                "state_color": tr.get("state_color", "secondary"),
+                "state_reason": tr.get("state_reason"),
+                "proximity_score": _f(tr.get("proximity_score")) or _f(e.get("proximity_score")) or 0.0,
+                "since_added_pct": (tr.get("performance") or {}).get("since_added_pct"),
+                "ref_close": (e.get("baseline") or {}).get("ref_close"),
+                "last_close": tr.get("last_close") or e.get("price"),
+                "mfe_pct": (tr.get("performance") or {}).get("mfe_pct"),
+                "mae_pct": (tr.get("performance") or {}).get("mae_pct"),
+                "lead_time_days": (tr.get("performance") or {}).get("lead_time_days"),
+                "days_since_added": tr.get("days_since_added"),
+                "days_to_catalyst": tr.get("days_to_catalyst"),
+                "resolution": tr.get("resolution"),
+                "resolution_label": tr.get("resolution_label"),
+                "ema": tr.get("ema") or {},
+                "rvol": tr.get("rvol"),
+                "pivot": tr.get("pivot") or e.get("pivot"),
+                "tags": e.get("tags") or [],
+                "signals": tr.get("signals") or [],
+                "prune": tr.get("prune") or {},
+                "added_date": e.get("added_date"),
+                "note": e.get("note", ""),
+                "rs_rank": e.get("rs_rank"),
+                "vcp_grade": e.get("vcp_grade"),
+                "updated_at": tr.get("updated_at"),
+            })
+    rows.sort(key=lambda r: (
+        -(r["proximity_score"] or 0),
+        STATE_ORDER.get(r["state"], 0) * -1,
+        r["ticker"],
+    ))
+    return rows
+
+
+def review_stats(wl: dict) -> dict:
+    """復盤統計：按狀態 / 標籤 / Resolution 匯總勝率與 MFE/MAE。"""
+    rows = rank_entries(wl)
+    total = len(rows)
+    by_state: dict[str, int] = {}
+    by_resolution: dict[str, int] = {}
+    by_tag: dict[str, dict[str, Any]] = {}
+
+    wins = losses = 0
+    mfes: list[float] = []
+    maes: list[float] = []
+    leads: list[float] = []
+
+    for r in rows:
+        by_state[r["state"]] = by_state.get(r["state"], 0) + 1
+        res = r.get("resolution") or RESOLUTION_PENDING
+        by_resolution[res] = by_resolution.get(res, 0) + 1
+
+        chg = _f(r.get("since_added_pct"))
+        if chg is not None:
+            if chg > 0:
+                wins += 1
+            elif chg < 0:
+                losses += 1
+        for v, bucket in ((r.get("mfe_pct"), mfes), (r.get("mae_pct"), maes),
+                          (r.get("lead_time_days"), leads)):
+            fv = _f(v)
+            if fv is not None:
+                bucket.append(fv)
+
+        for tag in r.get("tags") or []:
+            slot = by_tag.setdefault(tag, {"count": 0, "wins": 0, "sum_chg": 0.0})
+            slot["count"] += 1
+            if chg is not None:
+                slot["sum_chg"] += chg
+                if chg > 0:
+                    slot["wins"] += 1
+
+    for tag, slot in by_tag.items():
+        slot["win_rate"] = round(slot["wins"] / slot["count"] * 100, 1) if slot["count"] else 0.0
+        slot["avg_change_pct"] = round(slot["sum_chg"] / slot["count"], 2) if slot["count"] else 0.0
+        slot.pop("sum_chg", None)
+
+    def _avg(xs: list[float]) -> Optional[float]:
+        return round(sum(xs) / len(xs), 2) if xs else None
+
+    graded = wins + losses
+    return {
+        "total": total,
+        "by_state": by_state,
+        "by_resolution": by_resolution,
+        "by_tag": dict(sorted(by_tag.items(), key=lambda kv: -kv[1]["count"])),
+        "win_rate": round(wins / graded * 100, 1) if graded else None,
+        "winners": wins,
+        "losers": losses,
+        "avg_mfe_pct": _avg(mfes),
+        "avg_mae_pct": _avg(maes),
+        "avg_lead_time_days": _avg(leads),
+        "actionable": sum(1 for r in rows if r["state"] in (STATE_READY, STATE_TRIGGERED)),
+        "needs_pruning": [r["ticker"] for r in rows
+                          if (r.get("prune") or {}).get("auto")],
+    }
