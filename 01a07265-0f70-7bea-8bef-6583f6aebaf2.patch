+"""Unit tests for modules/watchlist_tracker.py (state-aware watchlist tracking)."""
+
+from __future__ import annotations
+
+from datetime import date, timedelta
+
+import numpy as np
+import pandas as pd
+import pytest
+
+from modules import watchlist_tracker as wt
+
+
+# ── fixtures / builders ──────────────────────────────────────────────────────
+
+def _frame(closes, volumes=None, *, start="2025-01-01", high_pad=0.5, low_pad=0.5):
+    n = len(closes)
+    idx = pd.bdate_range(start, periods=n)
+    close = np.asarray(closes, dtype=float)
+    vol = np.asarray(volumes if volumes is not None else [1_000_000.0] * n, dtype=float)
+    return pd.DataFrame(
+        {
+            "Open": close - 0.1,
+            "High": close + high_pad,
+            "Low": close - low_pad,
+            "Close": close,
+            "Volume": vol,
+        },
+        index=idx,
+    )
+
+
+def _base_range(n=140, level=100.0, amp=1.0):
+    """Tight sideways consolidation."""
+    return level + amp * np.sin(np.linspace(0, 8, n))
+
+
+# ── prepare_frame ────────────────────────────────────────────────────────────
+
+def test_prepare_frame_adds_required_columns():
+    df = _frame(_base_range())
+    out = wt.prepare_frame(df)
+    for col in ("EMA_10", "EMA_20", "EMA_50", "ATR_14", "VOL_SMA_50", "VOL_SMA_5"):
+        assert col in out.columns
+    assert not out["ATR_14"].isna().all()
+
+
+def test_prepare_frame_empty_input():
+    assert wt.prepare_frame(pd.DataFrame()).empty
+    assert wt.prepare_frame(None).empty
+
+
+# ── baseline ─────────────────────────────────────────────────────────────────
+
+def test_build_baseline_records_last_close():
+    closes = list(_base_range()) + [123.45]
+    df = _frame(closes)
+    b = wt.build_baseline(df, added_date="2025-06-01", note="hi", strategy="QM")
+    assert b["ref_close"] == 123.45
+    assert b["added_date"] == "2025-06-01"
+    assert b["strategy"] == "QM"
+    assert b["note"] == "hi"
+    assert b["ref_atr"] is not None
+    assert b["pivot"] is not None
+    assert b["swing_low"] is not None
+
+
+def test_build_baseline_handles_empty_frame():
+    b = wt.build_baseline(pd.DataFrame(), added_date="2025-06-01")
+    assert b["ref_close"] is None
+    assert b["added_date"] == "2025-06-01"
+
+
+# ── EMA trend ────────────────────────────────────────────────────────────────
+
+def test_ema_trend_uptrend_is_stacked():
+    closes = np.linspace(50, 150, 200)
+    trend = wt.analyze_ema_trend(_frame(closes))
+    assert trend["trend"] == "UP"
+    assert trend["stacked"] is True
+    assert trend["above_ema10"] and trend["above_ema20"] and trend["above_ema50"]
+    assert trend["slope_ema10_pct"] > 0
+
+
+def test_ema_trend_downtrend():
+    closes = np.linspace(150, 50, 200)
+    trend = wt.analyze_ema_trend(_frame(closes))
+    assert trend["trend"] == "DOWN"
+    assert trend["stacked"] is False
+    assert trend["slope_ema20_pct"] < 0
+
+
+def test_ema_tightness_is_small_in_flat_market():
+    trend = wt.analyze_ema_trend(_frame(_base_range(200, amp=0.3)))
+    assert trend["tightness_pct"] is not None
+    assert trend["tightness_pct"] < 2.0
+
+
+# ── state machine ────────────────────────────────────────────────────────────
+
+def test_state_building_for_quiet_consolidation():
+    closes = list(_base_range(160, level=100, amp=1.5))
+    df = _frame(closes)
+    res = wt.classify_state(df, pivot=115.0)
+    assert res["state"] == wt.STATE_BUILDING
+
+
+def test_state_ready_when_close_to_pivot():
+    closes = list(_base_range(160, level=100, amp=1.0))
+    df = _frame(closes, volumes=[1_000_000.0] * 155 + [400_000.0] * 5)
+    pivot = float(df["Close"].iloc[-1]) + 0.6   # well within 2 ATR
+    res = wt.classify_state(df, pivot=pivot)
+    assert res["state"] == wt.STATE_READY
+    assert "pivot" in res["reason"]
+
+
+def test_state_triggered_on_breakout_with_rvol():
+    closes = list(_base_range(159, level=100, amp=1.0)) + [110.0]
+    vols = [1_000_000.0] * 159 + [5_000_000.0]
+    df = _frame(closes, volumes=vols)
+    res = wt.classify_state(df, pivot=104.0)
+    assert res["state"] == wt.STATE_TRIGGERED
+    assert res["state_color"] == "success"
+
+
+def test_state_ready_when_breakout_lacks_volume():
+    closes = list(_base_range(159, level=100, amp=1.0)) + [104.5]
+    df = _frame(closes, volumes=[1_000_000.0] * 160)
+    # no gap: open flat vs prior close, so only the (absent) RVOL could confirm
+    df.loc[df.index[-1], "Open"] = float(df["Close"].iloc[-2])
+    res = wt.classify_state(df, pivot=104.0, prev_state=wt.STATE_BUILDING)
+    assert res["state"] == wt.STATE_READY
+
+
+def test_state_extended_when_far_from_ema10():
+    closes = list(_base_range(150, level=100, amp=1.0)) + list(np.linspace(102, 145, 15))
+    df = _frame(closes)
+    res = wt.classify_state(df, pivot=103.0, prev_state=wt.STATE_TRIGGERED)
+    assert res["state"] == wt.STATE_EXTENDED
+
+
+def test_breakout_day_is_triggered_not_extended():
+    """A stock breaking out today must be TRIGGERED even if already extended,
+    otherwise the entry timing and the trigger snapshot are both lost."""
+    closes = list(_base_range(150, level=100, amp=1.0)) + list(np.linspace(102, 145, 15))
+    df = _frame(closes, volumes=[1_000_000.0] * 164 + [6_000_000.0])
+    res = wt.classify_state(df, pivot=103.0, prev_state=wt.STATE_READY)
+    assert res["state"] == wt.STATE_TRIGGERED
+    # ...and only on the following updates does it roll into EXTENDED
+    nxt = wt.classify_state(df, pivot=103.0, prev_state=wt.STATE_TRIGGERED)
+    assert nxt["state"] == wt.STATE_EXTENDED
+
+
+def test_state_invalidated_on_structure_break():
+    closes = list(np.linspace(100, 140, 120)) + list(np.linspace(139, 80, 40))
+    df = _frame(closes)
+    res = wt.classify_state(df, pivot=145.0, prev_state=wt.STATE_READY)
+    assert res["state"] == wt.STATE_INVALIDATED
+    assert res["changed"] is True
+
+
+def test_state_cold_watch_after_long_quiet_period():
+    closes = list(_base_range(200, level=100, amp=0.5))
+    vols = [1_000_000.0] * 180 + [300_000.0] * 20
+    df = _frame(closes, volumes=vols)
+    res = wt.classify_state(df, pivot=130.0, days_since_added=40)
+    assert res["state"] == wt.STATE_COLD_WATCH
+
+
+def test_state_changed_flag_false_when_same():
+    df = _frame(_base_range(160))
+    res = wt.classify_state(df, pivot=130.0, prev_state=wt.STATE_BUILDING)
+    assert res["changed"] is False
+
+
+def test_classify_state_empty_frame_keeps_prev():
+    res = wt.classify_state(pd.DataFrame(), prev_state=wt.STATE_READY)
+    assert res["state"] == wt.STATE_READY
+
