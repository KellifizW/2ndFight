+def test_track_is_incremental_across_days(wl_mod, monkeypatch):
+    """Baseline stays anchored to the add date while price keeps moving."""
+    _seed(wl_mod, {"GOOG": ("SEPA", {"added_date": "2025-01-01", "market": "US"})})
+    base = list(100 + np.sin(np.linspace(0, 8, 160)))
+    monkeypatch.setattr(wl_mod, "detect_vcp", lambda d: {})
+
+    monkeypatch.setattr(wl_mod, "get_enriched", lambda t, period="2y": _make_df(base))
+    wl = wl_mod.track(market="US")
+    ref = wl["SEPA"]["GOOG"]["baseline"]["ref_close"]
+
+    later = base + [120.0, 125.0]
+    monkeypatch.setattr(wl_mod, "get_enriched", lambda t, period="2y": _make_df(later))
+    wl2 = wl_mod.track(market="US")
+    e = wl2["SEPA"]["GOOG"]
+    assert e["baseline"]["ref_close"] == ref            # anchor unchanged
+    assert e["tracking"]["performance"]["since_added_pct"] > 20
+    assert e["tracking"]["performance"]["mfe_pct"] > 20
