+    market = _normalize_market(request.args.get("market") or _load_market_mode())
+    try:
+        from modules import watchlist as wl_mod
+
+        data = wl_mod.timeline(ticker, market)
+        if not data:
+            return jsonify({"ok": False, "error": f"{ticker} not in watchlist"}), 404
+        return jsonify({"ok": True, **data})
+    except Exception as exc:
+        logger.exception("api_watchlist_timeline failed: %s", exc)
+        return jsonify({"ok": False, "error": str(exc)}), 500
+
+
+@bp.route("/api/watchlist/alerts", methods=["GET"])
+def api_watchlist_alerts():
+    """Active multi-dimensional triggers across the whole watchlist."""
+    market = _normalize_market(request.args.get("market") or _load_market_mode())
+    severity = (request.args.get("severity") or "info").lower()
+    try:
+        from modules import watchlist as wl_mod
+
+        return jsonify({"ok": True, "market": market,
+                        "alerts": wl_mod.alerts(market, min_severity=severity)})
+    except Exception as exc:
+        logger.exception("api_watchlist_alerts failed: %s", exc)
+        return jsonify({"ok": False, "error": str(exc), "alerts": []}), 500
+
+
+@bp.route("/api/watchlist/review", methods=["GET"])
+def api_watchlist_review():
+    """Post-mortem analytics: win rate, MFE/MAE, lead time, per-tag stats."""
+    market = _normalize_market(request.args.get("market") or _load_market_mode())
+    try:
+        from modules import watchlist as wl_mod
+
+        return jsonify({"ok": True, "market": market, "stats": wl_mod.review(market)})
+    except Exception as exc:
+        logger.exception("api_watchlist_review failed: %s", exc)
+        return jsonify({"ok": False, "error": str(exc)}), 500
+
+
+@bp.route("/api/watchlist/prune", methods=["POST"])
+def api_watchlist_prune():
+    """Auto-pruning: archive invalidated names, demote stale ones to COLD_WATCH."""
+    data = request.get_json(silent=True) or {}
+    market = _normalize_market(data.get("market") or _load_market_mode())
+    apply_changes = bool(data.get("apply"))
+    try:
+        from modules import watchlist as wl_mod
+
+        return jsonify({"ok": True, "market": market,
+                        **wl_mod.prune(market, apply=apply_changes)})
+    except Exception as exc:
+        logger.exception("api_watchlist_prune failed: %s", exc)
+        return jsonify({"ok": False, "error": str(exc)}), 500
+
