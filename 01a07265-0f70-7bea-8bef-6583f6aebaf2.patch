+// ── Auto-prune (dry-run first, then confirm) ────────────────────────────────
+async function pruneWatchlist() {
+  try {
+    const dry = await fetch('/api/watchlist/prune', {
+      method: 'POST', headers: {'Content-Type': 'application/json'},
+      body: JSON.stringify({market: ACTIVE_MARKET, apply: false})
+    }).then(x => x.json());
+    if (!dry.ok) throw new Error(dry.error || 'unknown error');
+    const arch = dry.archived || [], cold = dry.cold_watch || [];
+    if (!arch.length && !cold.length) { toast('沒有需要清理的標的 — 清單很乾淨'); return; }
+    const msg = [
+      arch.length ? `歸檔失敗案例 (${arch.length}): ${arch.map(a => a.ticker).join(', ')}` : '',
+      cold.length ? `降級 COLD_WATCH (${cold.length}): ${cold.map(c => c.ticker).join(', ')}` : ''
+    ].filter(Boolean).join('\n');
+    if (!confirm(`自動清理建議：\n\n${msg}\n\n確定執行？`)) return;
+    const res = await fetch('/api/watchlist/prune', {
+      method: 'POST', headers: {'Content-Type': 'application/json'},
+      body: JSON.stringify({market: ACTIVE_MARKET, apply: true})
+    }).then(x => x.json());
+    if (!res.ok) throw new Error(res.error || 'unknown error');
+    htmx.ajax('GET', `/htmx/watchlist/body?market=${ACTIVE_MARKET}`,
+              {target: '#wlBody', swap: 'innerHTML'});
+    loadReviewStats();
+    toast('✅ 自動清理完成');
+  } catch (e) { toast(`❌ Prune failed: ${e.message || e}`, false); }
+}
