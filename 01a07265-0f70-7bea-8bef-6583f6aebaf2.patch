+def _print_wl_review(stats: dict):
+    """Pretty-print the watchlist post-mortem analytics."""
+    print("\n  WATCHLIST REVIEW ANALYTICS")
+    print("  " + "─" * 58)
+    print(f"  Total tracked      : {stats.get('total', 0)}")
+    print(f"  Actionable         : {stats.get('actionable', 0)}  (READY + TRIGGERED)")
+    wr = stats.get("win_rate")
+    print(f"  Win rate           : {wr if wr is None else f'{wr:.1f}%'}"
+          f"  ({stats.get('winners', 0)}W / {stats.get('losers', 0)}L)")
+    print(f"  Avg MFE / MAE      : {stats.get('avg_mfe_pct')}% / {stats.get('avg_mae_pct')}%")
+    print(f"  Avg lead time      : {stats.get('avg_lead_time_days')} trading days")
+    if stats.get("by_state"):
+        print("\n  By state:")
+        for k, v in stats["by_state"].items():
+            print(f"    {k:<13} {v}")
+    if stats.get("by_resolution"):
+        print("\n  By resolution:")
+        for k, v in stats["by_resolution"].items():
+            print(f"    {k:<16} {v}")
+    if stats.get("by_tag"):
+        print("\n  By pattern tag:")
+        for k, v in stats["by_tag"].items():
+            print(f"    {k:<14} n={v['count']:<3} win={v['win_rate']}%  avg={v['avg_change_pct']}%")
+    if stats.get("needs_pruning"):
+        print(f"\n  Needs pruning      : {', '.join(stats['needs_pruning'])}")
+    print()
+
